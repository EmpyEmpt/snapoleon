# Install:
#   sudo useradd --system --home /var/lib/snapoleon --shell /usr/sbin/nologin snapoleon
#   sudo install -m 0755 snapoleon-server /usr/local/bin/
#   sudo install -d -o snapoleon -g snapoleon /var/lib/snapoleon
#   sudo install -D -m 0640 -o root -g snapoleon snapoleon-server.example.toml /etc/snapoleon/snapoleon-server.toml
#   sudo cp snapoleon-server.service /etc/systemd/system/ && sudo systemctl enable --now snapoleon-server
# The first start prints the bootstrap admin credentials:  journalctl -u snapoleon-server
[Unit]
Description=Snapoleon team server
Documentation=https://github.com/snapoleon/snapoleon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=snapoleon
Group=snapoleon
ExecStart=/usr/local/bin/snapoleon-server --config /etc/snapoleon/snapoleon-server.toml
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=3

StateDirectory=snapoleon
WorkingDirectory=/var/lib/snapoleon
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadWritePaths=/var/lib/snapoleon

[Install]
WantedBy=multi-user.target
